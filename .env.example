# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=comprepdf
MYSQL_PASSWORD=comprepdf123
MYSQL_DATABASE=comprepdf
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
NODE_ENV=development
PORT=3000
MAX_FILE_SIZE_MB=50
FILE_EXPIRY_HOURS=24

# Modulo de certificados (CA interna): ya NO usa X-Admin-Key/CERT_ADMIN_KEY.
# El acceso pasa a exigir un usuario con rol 'admin' (login por JWT).

# Python Worker
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# Autenticacion de usuarios (JWT)
# Secreto para firmar los JWT (HS256). Genera 64+ bytes aleatorios por entorno y
# NUNCA lo reutilices entre QA y produccion. Si queda vacio, el login/verificacion
# fallan cerrado (503) y nadie puede autenticarse.
JWT_SECRET=
# Expiracion del token (formato de la lib "ms": 8h, 30m, 1d...). Por defecto 8h.
JWT_EXPIRES_IN=8h
# Contrasena temporal del primer admin. El backend siembra el usuario `admin` en
# el arranque solo si esta definida (con must_change_password=true). Deja vacio
# tras el primer arranque.
ADMIN_INITIAL_PASSWORD=
# Autorregistro publico (POST /auth/register): dominio de correo permitido. Solo
# se aceptan correos que terminen en @este-dominio. Por defecto coopaspire.com.do.
ALLOWED_SIGNUP_DOMAIN=coopaspire.com.do
