# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=comprepdf
MYSQL_PASSWORD=comprepdf123
MYSQL_DATABASE=comprepdf
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
NODE_ENV=development
PORT=3000
MAX_FILE_SIZE_MB=50
FILE_EXPIRY_HOURS=24

# Modulo de certificados (CA interna) - solo TI
# Clave de administrador que protege la emision de certificados. Debe ser una
# cadena larga y aleatoria. Se envia en el header X-Admin-Key. Si queda vacia,
# el modulo de certificados permanece bloqueado (fail-closed).
CERT_ADMIN_KEY=

# Python Worker
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs
