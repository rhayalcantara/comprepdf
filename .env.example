# Plantilla del .env. Copiar a `.env` (permisos 600 en el servidor).
#
# En docker-compose (producción/qa del Puente) TODOS los servicios leen este
# archivo con `env_file`; los hosts de MySQL/Redis son los nombres de servicio
# del compose. En la pila nativa (dev/QA Windows) cada proceso lee su propio
# .env (backend/.env, python-worker/.env) y los hosts son localhost.
#
# NUNCA reutilizar los secretos (JWT_SECRET, contraseñas) entre entornos.

# ---- Publicación (solo compose) ----
# Puerto del host en el que nginx sirve la app (SPA + /api proxeado).
COMPREPDF_PORT=3060

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=cambiar
# Dejar `comprepdf`: database/schema.sql (initdb) crea y usa esa base por nombre.
MYSQL_DATABASE=comprepdf
MYSQL_USER=comprepdf
MYSQL_PASSWORD=cambiar
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- Redis (opcional; ya no es broker) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Backend ----
NODE_ENV=production
PORT=3000
MAX_FILE_SIZE_MB=50
FILE_EXPIRY_HOURS=24
# Minutos que sobrevive un paso intermedio del Estudio ya superado (permite deshacer).
INTERMEDIATE_JOB_TTL_MINUTES=120
# Orígenes CORS permitidos fuera de development, separados por coma. En compose
# el frontend proxea /api en el mismo origen y CORS no interviene; solo hace
# falta si el frontend se sirve desde otro host/puerto (QA nativo).
CORS_ORIGINS=http://localhost:4200
# Dónde están los .sql de database/migrations (el backend los aplica al arrancar).
# Se autodetecta (./database/migrations o ../database/migrations); rara vez hace falta.
# MIGRATIONS_DIR=

# ---- Directorios de trabajo (compartidos backend <-> worker) ----
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# ---- Autenticación (JWT) ----
# Secreto HS256: 64+ bytes aleatorios por entorno. Vacío => login bloqueado (503).
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Contraseña temporal del primer admin (must_change_password). Solo la lee el
# primer arranque; vaciar después.
ADMIN_INITIAL_PASSWORD=
# Dominio de correo permitido en el autorregistro.
ALLOWED_SIGNUP_DOMAIN=coopaspire.com.do

# ---- Worker: CA interna (módulo de certificados, solo admin) ----
CA_DIR=/app/ca-store
# Passphrase de la clave raíz. Obligatoria para emitir certificados (fail-closed).
CA_KEY_PASSWORD=
CA_COMMON_NAME=Coopaspire CA
CA_ORG=Coopaspire
CA_COUNTRY=DO
CA_VALIDITY_YEARS=15

# ---- Worker: traducción (Ollama local) ----
OLLAMA_URL=http://192.168.2.165:11434
OLLAMA_MODEL=qwen3.6:35b
OLLAMA_TIMEOUT=300

# ---- Worker: Office -> PDF (operación convert) ----
# Motor: com (Microsoft Office, solo Windows) | libreoffice (contenedor Linux).
# Se autodetecta; dejar vacío salvo para forzar uno.
# OFFICE_ENGINE=
# Ruta a soffice si no está en el PATH.
# LIBREOFFICE_PATH=
# Ghostscript si no está en el PATH (en Windows el binario es gswin64c, no gs).
# GHOSTSCRIPT_PATH=
