# Python worker (poller MySQL) — copia a .env y ajusta si hace falta.
# Los valores por defecto ya coinciden con estos; en local el .env es opcional.

# MySQL — debe apuntar a la MISMA instancia que el backend
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=comprepdf
MYSQL_USER=comprepdf
MYSQL_PASSWORD=comprepdf123

# Redis (opcional — el worker ya no usa broker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Directorios de trabajo.
# Nota: el backend guarda rutas ABSOLUTAS de los archivos en la DB, así que el
# worker lee los originales por su ruta absoluta sin depender de UPLOAD_DIR.
# OUTPUT_DIR es donde el worker escribe los resultados (el backend los sirve por
# la ruta absoluta almacenada). En la pila nativa quedan bajo python-worker/.
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# --- CA interna de la cooperativa (modulo de certificados) ---
# Directorio donde se custodian la clave y el certificado raiz. Mantener FUERA
# del repo y con acceso restringido (esta en .gitignore).
CA_DIR=./ca-store
# Passphrase que cifra la clave privada raiz. OBLIGATORIA para generar/cargar la
# CA. Debe ser larga y aleatoria, y NO debe versionarse. Sin ella el modulo de
# certificados no funciona (fail-closed).
CA_KEY_PASSWORD=
# Atributos del certificado raiz (valores por defecto si se omiten).
CA_COMMON_NAME=Coopaspire CA
CA_ORG=Coopaspire
CA_COUNTRY=DO
CA_VALIDITY_YEARS=15
