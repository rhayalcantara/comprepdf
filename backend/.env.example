# Backend (Node + Express + TypeORM) — copia a .env y ajusta si hace falta.
# Los valores por defecto ya coinciden con estos, así que en local puedes omitir el .env.

# Entorno / servidor
NODE_ENV=development
PORT=3000

# MySQL (mismos valores que usa docker-compose y la pila nativa)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=comprepdf
MYSQL_USER=comprepdf
MYSQL_PASSWORD=comprepdf123

# Redis (opcional — ya no es broker; el arranque continúa aunque no esté)
REDIS_HOST=localhost
REDIS_PORT=6379

# Uploads / outputs
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
FILE_EXPIRY_HOURS=24
