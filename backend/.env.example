# Backend (Node + Express + TypeORM) — copia a .env y ajusta si hace falta.
# Los valores por defecto ya coinciden con estos, así que en local puedes omitir el .env.

# Entorno / servidor
NODE_ENV=development
PORT=3000

# MySQL (mismos valores que usa docker-compose y la pila nativa)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=comprepdf
MYSQL_USER=comprepdf
MYSQL_PASSWORD=comprepdf123

# Redis (opcional — ya no es broker; el arranque continúa aunque no esté)
REDIS_HOST=localhost
REDIS_PORT=6379

# Uploads / outputs
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
FILE_EXPIRY_HOURS=24

# Autenticacion de usuarios (JWT)
# El modulo de certificados ya NO usa X-Admin-Key/CERT_ADMIN_KEY: ahora exige un
# usuario con rol 'admin' (login por JWT), igual que el resto de acciones.
# Secreto para firmar los JWT (HS256). Genera 64+ bytes aleatorios por entorno.
# Si queda vacio, el login/verificacion fallan cerrado (503).
JWT_SECRET=
# Expiracion del token (formato "ms": 8h, 30m, 1d...). Por defecto 8h.
JWT_EXPIRES_IN=8h
# Contrasena temporal del primer admin. El backend siembra el usuario `admin` en
# el arranque solo si esta definida (must_change_password=true).
ADMIN_INITIAL_PASSWORD=
